<?xml version="1.0" encoding="utf-8"?>
<androidx.preference.PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.wmdx.markdownapp.ResetPreferenceCategory
        app:key="category_panel"
        app:title="Search Panel Window">
        <com.wmdx.markdownapp.ResetColorPickerPreference
            app:key="pref_findreplace_panel_bg"
            app:title="Panel Background Color"
            app:summary="Background color for Find &amp; Replace panel"
            app:defaultValue="default" />

        <com.wmdx.markdownapp.ResetColorPickerPreference
            app:key="pref_findreplace_panel_border"
            app:title="Panel Bottom Border Color"
            app:summary="Separator border color at bottom of panel"
            app:defaultValue="default" />
    </com.wmdx.markdownapp.ResetPreferenceCategory>

    <com.wmdx.markdownapp.ResetPreferenceCategory
        app:key="category_field_find"
        app:title="Find Text Field">
        <com.wmdx.markdownapp.ResetColorPickerPreference
            app:key="pref_findreplace_field_find_bg"
            app:title="Find Field Background"
            app:summary="Background color for Find input box"
            app:defaultValue="default" />

        <com.wmdx.markdownapp.ResetColorPickerPreference
            app:key="pref_findreplace_field_find_color"
            app:title="Find Field Text Color"
            app:summary="Text color for typed find input"
            app:defaultValue="default" />

        <com.wmdx.markdownapp.ResetColorPickerPreference
            app:key="pref_findreplace_field_find_placeholder"
            app:title="Find Placeholder Color"
            app:summary="Color for 'Find...' hint text"
            app:defaultValue="default" />

        <com.wmdx.markdownapp.ResetColorPickerPreference
            app:key="pref_findreplace_field_find_border"
            app:title="Find Field Border Color"
            app:summary="Normal border color for Find field"
            app:defaultValue="default" />

        <com.wmdx.markdownapp.ResetColorPickerPreference
            app:key="pref_findreplace_field_find_focus_border"
            app:title="Find Field Focused Border"
            app:summary="Active border color when Find field is focused"
            app:defaultValue="default" />

        <com.wmdx.markdownapp.ResetSeekBarPreference
            app:key="pref_findreplace_field_find_font_size"
            app:title="Find Field Text Size (px)"
            app:summary="Font size for Find input"
            app:min="10"
            android:max="24"
            app:defaultValue="14"
            app:showSeekBarValue="true" />

        <com.wmdx.markdownapp.ResetSeekBarPreference
            app:key="pref_findreplace_field_height"
            app:title="Field Row Height (px)"
            app:summary="Row height for input fields and aligned action buttons"
            app:min="24"
            android:max="56"
            app:defaultValue="32"
            app:showSeekBarValue="true" />
    </com.wmdx.markdownapp.ResetPreferenceCategory>

    <com.wmdx.markdownapp.ResetPreferenceCategory
