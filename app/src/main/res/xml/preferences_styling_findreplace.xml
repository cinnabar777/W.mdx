        <com.wmdx.markdownapp.ResetColorPickerPreference
            app:key="pref_findreplace_current_match_color"
            app:title="Active Match Text Color"
            app:summary="Text color for currently active selected match"
            app:defaultValue="default" />
    </com.wmdx.markdownapp.ResetPreferenceCategory>

