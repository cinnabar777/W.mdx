        <com.wmdx.markdownapp.ResetEditTextPreference app:key="pref_findreplace_btn_prev_svg" app:title="Custom SVG Icon" app:summary="Choose an SVG file or paste SVG code" app:defaultValue="" />
    </com.wmdx.markdownapp.ResetPreferenceCategory>

