<?xml version="1.0" encoding="utf-8"?>
<androidx.preference.PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.wmdx.markdownapp.ResetPreferenceCategory app:title="Block Quote Settings">
        <com.wmdx.markdownapp.ResetSeekBarPreference
            app:key="pref_blockquote_line_thickness"
            app:title="Block Quote Border Thickness (px)"
            app:summary="Thickness of the left accent border"
            app:min="1"
            android:max="20"
            app:defaultValue="4"
            app:showSeekBarValue="true" />

        <com.wmdx.markdownapp.ResetListPreference
            app:key="pref_blockquote_line_style"
            app:title="Block Quote Border Style"
            app:summary="Style of left accent border"
            android:entries="@array/border_style_entries"
            android:entryValues="@array/border_style_values"
            android:defaultValue="solid" />

        <com.wmdx.markdownapp.ResetColorPickerPreference
            app:key="pref_blockquote_line_color"
            app:title="Block Quote Border Color"
            app:summary="Tap to select border color or default"
            app:defaultValue="default" />

        <com.wmdx.markdownapp.ResetColorPickerPreference
            app:key="pref_blockquote_bg_color"
            app:title="Block Quote Background Color"
            app:summary="Tap to select background color or default"
            app:defaultValue="default" />

        <com.wmdx.markdownapp.ResetColorPickerPreference
            app:key="pref_blockquote_text_color"
            app:title="Block Quote Text Color"
            app:summary="Tap to select text color or default"
            app:defaultValue="default" />

        <com.wmdx.markdownapp.ResetSeekBarPreference
            app:key="pref_blockquote_left_indent"
            app:title="Block Quote Left Margin (px)"
            app:summary="Left margin offset for block quotes"
            app:min="0"
            android:max="40"
            app:defaultValue="0"
            app:showSeekBarValue="true" />

        <com.wmdx.markdownapp.ResetSeekBarPreference
            app:key="pref_blockquote_padding"
            app:title="Block Quote Inside Padding (px)"
            app:summary="Padding inside block quote container"
            app:min="0"
            android:max="30"
            app:defaultValue="12"
            app:showSeekBarValue="true" />
    </com.wmdx.markdownapp.ResetPreferenceCategory>

    <com.wmdx.markdownapp.ResetPreferenceCategory app:title="Callouts Settings">
        <com.wmdx.markdownapp.ResetSeekBarPreference
            app:key="pref_callout_line_thickness"
            app:title="Callout Border Thickness (px)"
            app:summary="Thickness of callout accent border"
            app:min="1"
            android:max="20"
            app:defaultValue="4"
            app:showSeekBarValue="true" />

        <com.wmdx.markdownapp.ResetListPreference
            app:key="pref_callout_line_style"
            app:title="Callout Border Style"
            app:summary="Style of callout border"
            android:entries="@array/border_style_entries"
            android:entryValues="@array/border_style_values"
            android:defaultValue="solid" />

        <com.wmdx.markdownapp.ResetColorPickerPreference
            app:key="pref_callout_line_color"
            app:title="Callout Border Color"
            app:summary="Tap to select border color or default"
            app:defaultValue="default" />

        <com.wmdx.markdownapp.ResetColorPickerPreference
            app:key="pref_callout_bg_color"
            app:title="Callout Background Color"
            app:summary="Tap to select background tint color or default"
            app:defaultValue="default" />

        <com.wmdx.markdownapp.ResetColorPickerPreference
            app:key="pref_callout_text_color"
            app:title="Callout Text Color"
            app:summary="Text color for callout body text"
            app:defaultValue="default" />

        <com.wmdx.markdownapp.ResetSeekBarPreference
            app:key="pref_callout_padding"
            app:title="Callout Inside Padding (px)"
            app:summary="Padding inside callout container"
            app:min="0"
            android:max="30"
            app:defaultValue="12"
            app:showSeekBarValue="true" />
    </com.wmdx.markdownapp.ResetPreferenceCategory>

    <com.wmdx.markdownapp.ResetPreferenceCategory app:title="Callout Shared Header Settings">
        <com.wmdx.markdownapp.ResetColorPickerPreference
            app:key="pref_callout_header_bg_color"
            app:title="Header Background Color"
            app:summary="Background color for callout title headers"
            app:defaultValue="default" />

        <com.wmdx.markdownapp.ResetColorPickerPreference
            app:key="pref_callout_header_title_color"
            app:title="Header Title Text Color"
            app:summary="Text color for callout title text"
            app:defaultValue="default" />

        <com.wmdx.markdownapp.ResetSeekBarPreference
            app:key="pref_callout_header_font_size"
            app:title="Header Title Text Size (px)"
            app:summary="Font size for callout headers"
            app:min="10"
            android:max="32"
            app:defaultValue="16"
            app:showSeekBarValue="true" />

        <com.wmdx.markdownapp.ResetListPreference
            app:key="pref_callout_header_font_weight"
            app:title="Header Font Weight"
            app:summary="Font weight for callout headers"
            android:entries="@array/font_weight_entries"
            android:entryValues="@array/font_weight_values"
            android:defaultValue="700" />

        <com.wmdx.markdownapp.ResetSeekBarPreference
            app:key="pref_callout_header_padding"
            app:title="Header Padding (px)"
            app:summary="Padding inside callout headers"
            app:min="0"
            android:max="20"
            app:defaultValue="4"
            app:showSeekBarValue="true" />
    </com.wmdx.markdownapp.ResetPreferenceCategory>

    <com.wmdx.markdownapp.ResetPreferenceCategory app:title="Callout Per-Type Overrides">
        <com.wmdx.markdownapp.ResetListPreference
            app:key="pref_callout_type_selector"
            app:title="Select Callout Type To Customise"
            app:summary="Select type to customize header color &amp; accent"
            android:entries="@array/callout_type_entries"
            android:entryValues="@array/callout_type_values"
            android:defaultValue="info" />

        <com.wmdx.markdownapp.ResetColorPickerPreference
            app:key="pref_callout_override_info_bg"
            app:title="Info Header Background"
            app:summary="Header bg override for [!info]"
            app:defaultValue="default" />

        <com.wmdx.markdownapp.ResetColorPickerPreference
            app:key="pref_callout_override_info_color"
            app:title="Info Header Accent Color"
            app:summary="Accent &amp; border override for [!info]"
            app:defaultValue="default" />

        <com.wmdx.markdownapp.ResetColorPickerPreference
            app:key="pref_callout_override_faq_bg"
            app:title="FAQ Header Background"
            app:summary="Header bg override for [!faq]"
            app:defaultValue="default" />

        <com.wmdx.markdownapp.ResetColorPickerPreference
            app:key="pref_callout_override_faq_color"
            app:title="FAQ Header Accent Color"
            app:summary="Accent &amp; border override for [!faq]"
            app:defaultValue="default" />

        <com.wmdx.markdownapp.ResetColorPickerPreference
            app:key="pref_callout_override_question_bg"
            app:title="Question Header Background"
            app:summary="Header bg override for [!question]"
            app:defaultValue="default" />

        <com.wmdx.markdownapp.ResetColorPickerPreference
            app:key="pref_callout_override_question_color"
            app:title="Question Header Accent Color"
            app:summary="Accent &amp; border override for [!question]"
            app:defaultValue="default" />

        <com.wmdx.markdownapp.ResetColorPickerPreference
            app:key="pref_callout_override_todo_bg"
            app:title="Todo Header Background"
            app:summary="Header bg override for [!todo]"
            app:defaultValue="default" />

        <com.wmdx.markdownapp.ResetColorPickerPreference
            app:key="pref_callout_override_todo_color"
            app:title="Todo Header Accent Color"
            app:summary="Accent &amp; border override for [!todo]"
            app:defaultValue="default" />

        <com.wmdx.markdownapp.ResetColorPickerPreference
            app:key="pref_callout_override_example_bg"
            app:title="Example Header Background"
            app:summary="Header bg override for [!example]"
            app:defaultValue="default" />

        <com.wmdx.markdownapp.ResetColorPickerPreference
            app:key="pref_callout_override_example_color"
            app:title="Example Header Accent Color"
            app:summary="Accent &amp; border override for [!example]"
            app:defaultValue="default" />
    </com.wmdx.markdownapp.ResetPreferenceCategory>

</androidx.preference.PreferenceScreen>
