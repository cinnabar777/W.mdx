            app:defaultValue="ctrl+shift+8" />

        <com.wmdx.markdownapp.ResetEditTextPreference
            app:key="pref_hotkey_codeBlock"
            app:title="Code Block"
            app:defaultValue="ctrl+shift+c" />

        <com.wmdx.markdownapp.ResetEditTextPreference
            app:key="pref_hotkey_underline"
            app:title="Cycle Underline Style"
            app:defaultValue="ctrl+u" />

        <com.wmdx.markdownapp.ResetEditTextPreference
            app:key="pref_hotkey_outdent"
            app:title="Decrease Indent"
            app:defaultValue="shift+tab" />

        <com.wmdx.markdownapp.ResetEditTextPreference
            app:key="pref_hotkey_findAndReplace"
            app:title="Find &amp; Replace"
            app:defaultValue="ctrl+f" />

        <com.wmdx.markdownapp.ResetEditTextPreference
            app:key="pref_hotkey_horizontalLine"
