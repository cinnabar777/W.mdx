<?xml version="1.0" encoding="utf-8"?>
<androidx.preference.PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.wmdx.markdownapp.ResetPreferenceCategory app:title="App Actions">
        <com.wmdx.markdownapp.ResetEditTextPreference
            app:key="pref_hotkey_export"
            app:title="Export HTML / MHTML"
            app:summary="Key combination (e.g. ctrl+shift+e)"
            app:defaultValue="ctrl+shift+e" />

        <com.wmdx.markdownapp.ResetEditTextPreference
            app:key="pref_hotkey_history_back"
            app:title="History Back"
            app:summary="Navigate back through heading and document history (e.g. alt+left)"
            app:defaultValue="alt+left" />

        <com.wmdx.markdownapp.ResetEditTextPreference
            app:key="pref_hotkey_history_forward"
            app:title="History Forward"
            app:summary="Navigate forward through heading and document history (e.g. alt+right)"
            app:defaultValue="alt+right" />

        <com.wmdx.markdownapp.ResetEditTextPreference
            app:key="pref_hotkey_image"
            app:title="Insert Image"
            app:summary="Key combination (e.g. ctrl+shift+i)"
            app:defaultValue="ctrl+shift+i" />

        <com.wmdx.markdownapp.ResetEditTextPreference
            app:key="pref_hotkey_new"
            app:title="New Document"
            app:summary="Key combination (e.g. ctrl+n)"
            app:defaultValue="ctrl+n" />

        <com.wmdx.markdownapp.ResetEditTextPreference
            app:key="pref_hotkey_open"
            app:title="Open Document"
            app:summary="Key combination (e.g. ctrl+o)"
            app:defaultValue="ctrl+o" />

        <com.wmdx.markdownapp.ResetEditTextPreference
            app:key="pref_hotkey_settings"
            app:title="Open Settings"
            app:summary="Key combination (e.g. ctrl+,)"
            app:defaultValue="ctrl+," />

        <com.wmdx.markdownapp.ResetEditTextPreference
            app:key="pref_hotkey_open_with"
            app:title="Open with Alternate Engine"
            app:summary="Key combination (e.g. ctrl+shift+o)"
            app:defaultValue="ctrl+shift+o" />

        <com.wmdx.markdownapp.ResetEditTextPreference
            app:key="pref_hotkey_save_as"
            app:title="Save As"
            app:summary="Key combination (e.g. ctrl+shift+s)"
            app:defaultValue="ctrl+shift+s" />

        <com.wmdx.markdownapp.ResetEditTextPreference
            app:key="pref_hotkey_save_as_textpack"
            app:title="Save as Text Pack"
            app:summary="Key combination (e.g. ctrl+shift+alt+s)"
            app:defaultValue="ctrl+shift+alt+s" />

        <com.wmdx.markdownapp.ResetEditTextPreference
            app:key="pref_hotkey_save"
            app:title="Save Document"
            app:summary="Key combination (e.g. ctrl+s)"
            app:defaultValue="ctrl+s" />

        <com.wmdx.markdownapp.ResetEditTextPreference
            app:key="pref_hotkey_save_tabs"
            app:title="Save Tabs"
            app:summary="Key combination (leave empty to disable)"
            app:defaultValue="" />

        <com.wmdx.markdownapp.ResetEditTextPreference
            app:key="pref_hotkey_toggle_toolbar"
            app:title="Toggle Bottom Toolbar"
            app:summary="Key combination (e.g. ctrl+t)"
            app:defaultValue="ctrl+t" />

        <com.wmdx.markdownapp.ResetEditTextPreference
            app:key="pref_hotkey_line_numbers"
            app:title="Toggle Line Numbers"
            app:summary="Key combination (e.g. ctrl+alt+l)"
            app:defaultValue="ctrl+alt+l" />

        <com.wmdx.markdownapp.ResetEditTextPreference
            app:key="pref_hotkey_line_wrap"
            app:title="Toggle Line Wrap"
            app:summary="Key combination (e.g. ctrl+alt+w)"
            app:defaultValue="ctrl+alt+w" />
    </com.wmdx.markdownapp.ResetPreferenceCategory>

    <com.wmdx.markdownapp.ResetPreferenceCategory app:title="Formatting &amp; Tools">
        <com.wmdx.markdownapp.ResetEditTextPreference
            app:key="pref_hotkey_blockQuote"
