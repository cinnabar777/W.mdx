        <com.wmdx.markdownapp.ResetEditTextPreference
            app:key="pref_hotkey_code"
            app:title="Inline Code"
            app:defaultValue="ctrl+e" />

        <com.wmdx.markdownapp.ResetEditTextPreference
            app:key="pref_hotkey_callout"
            app:title="Insert Callout"
            app:defaultValue="ctrl+alt+q" />

        <com.wmdx.markdownapp.ResetEditTextPreference
            app:key="pref_hotkey_footnote"
            app:title="Insert Footnote"
            app:defaultValue="ctrl+shift+f" />

        <com.wmdx.markdownapp.ResetEditTextPreference
            app:key="pref_hotkey_italic"
            app:title="Italic"
            app:defaultValue="ctrl+i" />

        <com.wmdx.markdownapp.ResetEditTextPreference
            app:key="pref_hotkey_link"
            app:title="Link"
            app:defaultValue="ctrl+k" />

        <com.wmdx.markdownapp.ResetEditTextPreference
            app:key="pref_hotkey_numberedList"
            app:title="Numbered List"
            app:defaultValue="ctrl+shift+7" />

        <com.wmdx.markdownapp.ResetEditTextPreference
            app:key="pref_hotkey_sourceEditing"
            app:title="Source Code View"
            app:defaultValue="ctrl+shift+u" />

        <com.wmdx.markdownapp.ResetEditTextPreference
            app:key="pref_hotkey_strikethrough"
            app:title="Strikethrough"
            app:defaultValue="ctrl+shift+x" />

        <com.wmdx.markdownapp.ResetEditTextPreference
            app:key="pref_hotkey_todoList"
            app:title="To-Do List"
            app:defaultValue="ctrl+shift+l" />

        <com.wmdx.markdownapp.ResetEditTextPreference
            app:key="pref_hotkey_underlineDashed"
            app:title="Underline Dashed"
            app:defaultValue="" />

        <com.wmdx.markdownapp.ResetEditTextPreference
            app:key="pref_hotkey_underlineDotted"
            app:title="Underline Dotted"
            app:defaultValue="" />

        <com.wmdx.markdownapp.ResetEditTextPreference
            app:key="pref_hotkey_underlineDouble"
            app:title="Underline Double"
            app:defaultValue="" />

        <com.wmdx.markdownapp.ResetEditTextPreference
            app:key="pref_hotkey_underlineSolid"
            app:title="Underline Solid"
            app:defaultValue="" />

        <com.wmdx.markdownapp.ResetEditTextPreference
            app:key="pref_hotkey_underlineWavy"
            app:title="Underline Wavy"
            app:defaultValue="" />
    </com.wmdx.markdownapp.ResetPreferenceCategory>

    <com.wmdx.markdownapp.ResetPreferenceCategory app:title="Headings">
        <com.wmdx.markdownapp.ResetEditTextPreference
            app:key="pref_hotkey_heading_1"
            app:title="Heading 1"
            app:defaultValue="ctrl+alt+1" />

        <com.wmdx.markdownapp.ResetEditTextPreference
            app:key="pref_hotkey_heading_2"
            app:title="Heading 2"
            app:defaultValue="ctrl+alt+2" />

        <com.wmdx.markdownapp.ResetEditTextPreference
            app:key="pref_hotkey_heading_3"
            app:title="Heading 3"
            app:defaultValue="ctrl+alt+3" />

        <com.wmdx.markdownapp.ResetEditTextPreference
            app:key="pref_hotkey_heading_4"
            app:title="Heading 4"
            app:defaultValue="ctrl+alt+4" />

        <com.wmdx.markdownapp.ResetEditTextPreference
            app:key="pref_hotkey_heading_5"
            app:title="Heading 5"
            app:defaultValue="ctrl+alt+5" />

        <com.wmdx.markdownapp.ResetEditTextPreference
            app:key="pref_hotkey_heading_6"
            app:title="Heading 6"
            app:defaultValue="ctrl+alt+6" />

        <com.wmdx.markdownapp.ResetEditTextPreference
            app:key="pref_hotkey_heading_p"
            app:title="Paragraph / Normal Text"
            app:defaultValue="ctrl+alt+0" />
    </com.wmdx.markdownapp.ResetPreferenceCategory>

    <com.wmdx.markdownapp.ResetPreferenceCategory app:title="Highlights &amp; Pens">
        <com.wmdx.markdownapp.ResetEditTextPreference
            app:key="pref_hotkey_highlight_blue"
            app:title="Blue Marker"
            app:defaultValue="ctrl+alt+b" />

        <com.wmdx.markdownapp.ResetEditTextPreference
            app:key="pref_hotkey_highlight_green"
            app:title="Green Marker"
            app:defaultValue="ctrl+alt+g" />

        <com.wmdx.markdownapp.ResetEditTextPreference
            app:key="pref_hotkey_highlight_green_pen"
            app:title="Green Pen Text Color"
            app:defaultValue="ctrl+alt+shift+g" />

        <com.wmdx.markdownapp.ResetEditTextPreference
