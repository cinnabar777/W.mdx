      "expected": {
        "tables": 0,
        "strikethrough": 0,
        "autolinks": 2
      }
    },
    {
      "number": 627,
      "section": "Autolinks (extension)",
      "extension": "autolink",
      "markdown": "www.commonmark.org/he<lp\n",
      "expected": {
        "tables": 0,
        "strikethrough": 0,
        "autolinks": 1
      }
    },
    {
      "number": 628,
      "section": "Autolinks (extension)",
      "extension": "autolink",
      "markdown": "http://commonmark.org\n\n(Visit https://encrypted.google.com/search?q=Markup+(business))\n\nAnonymous FTP is available at ftp://foo.bar.baz.\n",
      "expected": {
        "tables": 0,
        "strikethrough": 0,
        "autolinks": 3
      }
    },
    {
      "number": 629,
      "section": "Autolinks (extension)",
      "extension": "autolink",
      "markdown": "foo@bar.baz\n",
      "expected": {
        "tables": 0,
        "strikethrough": 0,
        "autolinks": 1
      }
    },
    {
      "number": 630,
      "section": "Autolinks (extension)",
      "extension": "autolink",
      "markdown": "hello@mail+xyz.example isn't valid, but hello+xyz@mail.example is.\n",
      "expected": {
        "tables": 0,
        "strikethrough": 0,
        "autolinks": 1
      }
    },
    {
      "number": 631,
      "section": "Autolinks (extension)",
      "extension": "autolink",
      "markdown": "a.b-c_d@a.b\n\na.b-c_d@a.b.\n\na.b-c_d@a.b-\n\na.b-c_d@a.b_\n",
      "expected": {
        "tables": 0,
        "strikethrough": 0,
        "autolinks": 2
      }
    }
  ],
  "excludedExamples": [
