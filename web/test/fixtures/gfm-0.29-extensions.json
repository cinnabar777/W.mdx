{
  "specification": "GitHub Flavored Markdown 0.29",
  "source": "https://github.com/github/cmark-gfm/blob/master/test/spec.txt",
  "license": "CC-BY-SA-4.0",
  "attribution": "GitHub Flavored Markdown Spec, version 0.29; adapted to store semantic expectations instead of rendered HTML.",
  "examples": [
    {
      "number": 198,
      "section": "Tables (extension)",
      "extension": "table",
      "markdown": "| foo | bar |\n| --- | --- |\n| baz | bim |\n",
      "expected": {
        "tables": 1,
        "strikethrough": 0,
        "autolinks": 0
      }
    },
    {
      "number": 199,
      "section": "Tables (extension)",
      "extension": "table",
      "markdown": "| abc | defghi |\n:-: | -----------:\nbar | baz\n",
      "expected": {
        "tables": 1,
        "strikethrough": 0,
        "autolinks": 0
      }
    },
    {
      "number": 200,
      "section": "Tables (extension)",
      "extension": "table",
      "markdown": "| f\\|oo  |\n| ------ |\n| b `\\|` az |\n| b **\\|** im |\n",
      "expected": {
        "tables": 1,
        "strikethrough": 0,
        "autolinks": 0
      }
    },
    {
      "number": 201,
      "section": "Tables (extension)",
      "extension": "table",
      "markdown": "| abc | def |\n| --- | --- |\n| bar | baz |\n> bar\n",
      "expected": {
        "tables": 1,
        "strikethrough": 0,
        "autolinks": 0
      }
    },
    {
      "number": 202,
      "section": "Tables (extension)",
      "extension": "table",
      "markdown": "| abc | def |\n| --- | --- |\n| bar | baz |\nbar\n\nbar\n",
      "expected": {
        "tables": 1,
        "strikethrough": 0,
        "autolinks": 0
      }
    },
    {
      "number": 203,
      "section": "Tables (extension)",
      "extension": "table",
      "markdown": "| abc | def |\n| --- |\n| bar |\n",
      "expected": {
        "tables": 0,
        "strikethrough": 0,
        "autolinks": 0
      }
    },
    {
      "number": 204,
      "section": "Tables (extension)",
      "extension": "table",
      "markdown": "| abc | def |\n| --- | --- |\n| bar |\n| bar | baz | boo |\n",
      "expected": {
        "tables": 1,
        "strikethrough": 0,
        "autolinks": 0
      }
    },
    {
      "number": 205,
      "section": "Tables (extension)",
      "extension": "table",
      "markdown": "| abc | def |\n| --- | --- |\n",
      "expected": {
        "tables": 1,
        "strikethrough": 0,
        "autolinks": 0
      }
    },
    {
      "number": 491,
      "section": "Strikethrough (extension)",
      "extension": "strikethrough",
      "markdown": "~~Hi~~ Hello, world!\n",
      "expected": {
        "tables": 0,
        "strikethrough": 1,
        "autolinks": 0
      }
    },
    {
      "number": 492,
      "section": "Strikethrough (extension)",
      "extension": "strikethrough",
      "markdown": "This ~~has a\n\nnew paragraph~~.\n",
      "expected": {
        "tables": 0,
        "strikethrough": 0,
        "autolinks": 0
      }
    },
    {
      "number": 621,
      "section": "Autolinks (extension)",
      "extension": "autolink",
      "markdown": "www.commonmark.org\n",
      "expected": {
        "tables": 0,
        "strikethrough": 0,
        "autolinks": 1
      }
    },
    {
      "number": 622,
      "section": "Autolinks (extension)",
      "extension": "autolink",
      "markdown": "Visit www.commonmark.org/help for more information.\n",
